#!/usr/bin/env php
<?php

/**
 * Trindade MCP Server
 *
 * Model Context Protocol — exposes Trindade framework as AI tools.
 * Runs over stdio. Connect to Claude Desktop, Cursor, etc.
 *
 * Usage:
 *   php bin/mcp
 *
 * For Claude Desktop, add to claude_desktop_config.json:
 * {
 *   "mcpServers": {
 *     "trindade": {
 *       "command": "php",
 *       "args": ["bin/mcp"],
 *       "cwd": "/Users/user/my-project"
 *     }
 *   }
 * }
 */

if (php_sapi_name() !== 'cli') {
    exit('CLI only' . PHP_EOL);
}

// Find autoload
$autoloads = [
    dirname(__DIR__) . '/vendor/autoload.php',
    dirname(__DIR__) . '/../../autoload.php',
];
$autoload = null;
foreach ($autoloads as $a) { if (file_exists($a)) { $autoload = $a; break; } }
if (!$autoload) exit("Run composer install first.\n");

require $autoload;

$mcp = new \Trindade\Mcp();
$mcp->serve();
