#!/usr/bin/env php
<?php

/**
 * Trindade CLI
 *
 *   php trindade routes              List all routes
 *   php trindade cache:clear         Clear cache storage
 *   php trindade key:generate        Generate a secure APP_KEY
 *   php trindade serve [--port=8000] Start PHP dev server
 *   php trindade make:password       Hash a password (prompts securely)
 *   php trindade make:jwt [payload]  Generate a JWT token
 *   php trindade env:check           Check required PHP extensions
 *   php trindade help                This help
 */

if (php_sapi_name() !== 'cli') {
    exit('CLI only' . PHP_EOL);
}

// Find autoload
$autoloads = [
    dirname(__DIR__) . '/vendor/autoload.php',
    dirname(__DIR__) . '/../../autoload.php',
];
$autoload = null;
foreach ($autoloads as $a) { if (file_exists($a)) { $autoload = $a; break; } }
if (!$autoload) exit("Run composer install first.\n");

require $autoload;

// Load config if exists
$config = [];
$config_file = dirname(__DIR__) . '/config.php';
if (file_exists($config_file)) $config = require $config_file;

$cmd = $argv[1] ?? 'help';
$port = 8000;

foreach ($argv as $a) {
    if (strpos($a, '--port=') === 0) $port = (int)substr($a, 7);
}

try {
    switch ($cmd) {
        case 'routes':
            echo "\n\033[1;36m Trindade Routes \033[0m\n";
            echo str_repeat('─', 70) . "\n";

            $app = new \Trindade\Trindade(array_merge(['test' => true], $config));
            $found = false;

            foreach ($app->routes() as $method => $routes) {
                foreach ($routes as $path => $route) {
                    $vhost = !empty($route['vhost']) ? " [{$route['vhost']}]" : '';
                    printf("  \033[1;33m%-8s\033[0m %s%s\n", $method, $path, $vhost);
                    $found = true;
                }
            }
            if (!$found) echo "  No routes defined yet.\n";
            echo str_repeat('─', 70) . "\n\n";
            break;

        case 'cache:clear':
            $app = new \Trindade\Trindade($config);
            $app->clear();
            $app->clear('logs');
            $app->clear('temp');
            echo "\033[32m Cache cleared.\033[0m\n";
            break;

        case 'key:generate':
            $key = 'base64:' . base64_encode(random_bytes(32));
            echo "\033[32m APP_KEY: \033[0m{$key}\n\n";
            echo "Add to config.php: 'app_key' => '{$key}'\n\n";
            break;

        case 'serve':
            $host = '127.0.0.1';
            $docroot = dirname(__DIR__) . '/public';
            if (!is_dir($docroot)) { echo "\033[31m public/ directory not found.\033[0m\n"; exit(1); }
            echo "\033[36m Trindade dev server on http://{$host}:{$port}\033[0m\n";
            echo "Document root: {$docroot}\n";

            // Check if Studio plugin is installed
            $studio = dirname(__DIR__) . '/plugins/Studio.php';
            if (file_exists($studio)) {
                echo "\033[1;35m Studio: http://{$host}:{$port}/studio\033[0m\n";
                echo "  Default password: trindade\n";
            }

            echo "Press Ctrl+C to stop.\n\n";
            passthru("php -S {$host}:{$port} -t \"" . dirname(__DIR__) . "/public\"");
            break;

        case 'studio':
            echo "\n\033[1;35m Trindade Studio \033[0m\n\n";
            echo "  Web IDE for routes, database, files, API testing.\n\n";
            $studio = dirname(__DIR__) . '/plugins/Studio.php';
            if (file_exists($studio)) {
                echo "  \033[32m✔ Installed\033[0m\n";
                echo "  Start with: php trindade serve\n";
                echo "  Open: http://localhost:8000/studio\n";
                echo "  Default password: trindade\n";
                echo "\n  Configure in config.php:\n";
                echo "    'studio' => ['password' => 'your-secret-password'],\n";
            } else {
                echo "  Run \033[33mphp trindade studio:install\033[0m to install.\n";
            }
            echo "\n";
            break;

        case 'studio:install':
            $studio_file = dirname(__DIR__) . '/plugins/Studio.php';
            if (file_exists($studio_file)) {
                echo "\033[32m Studio is already installed.\033[0m\n";
                echo "  Open http://localhost:8000/studio after starting the server.\n\n";
                break;
            }
            // Studio is already in plugins/ (bundled with framework)
            echo "\033[32m Studio plugin ready.\033[0m\n";
            echo "  Add to config.php:\n";
            echo "    'studio' => ['password' => 'your-secret-password'],\n\n";
            echo "  Start: php trindade serve\n";
            echo "  Open: http://localhost:8000/studio\n\n";
            break;

        case 'make:password':
            echo "Password: ";
            system('stty -echo');
            $pass = trim(fgets(STDIN));
            system('stty echo');
            echo "\n";
            if (empty($pass)) { echo "\033[31m Password cannot be empty.\033[0m\n"; exit(1); }
            $hash = password_hash($pass, PASSWORD_BCRYPT, ['cost' => 12]);
            echo "\033[32m Hash:\033[0m {$hash}\n\n";
            break;

        case 'make:jwt':
            $app = new \Trindade\Trindade($config);
            $payload = isset($argv[2]) ? json_decode($argv[2], true) : ['test' => true];
            if (!is_array($payload)) $payload = ['data' => $argv[2]];
            $token = $app->jwt($payload);
            echo "\033[32m JWT:\033[0m {$token}\n\n";
            break;

        case 'env:check':
            echo "\n\033[1;36m Trindade Environment Check \033[0m\n";
            echo str_repeat('─', 40) . "\n";

            $extensions = [
                'pdo'     => 'Database',
                'json'    => 'JSON handling',
                'fileinfo'=> 'File upload MIME detection',
                'curl'    => 'API import',
                'gd'      => 'QR code generation',
                'mbstring'=> 'Multibyte strings',
                'openssl' => 'Secure WebSocket / JWT',
            ];

            foreach ($extensions as $ext => $use) {
                $ok = extension_loaded($ext);
                $icon = $ok ? "\033[32m✔\033[0m" : "\033[31m✘\033[0m";
                printf("  %s %-12s (%s)\n", $icon, $ext, $use);
            }

            echo str_repeat('─', 40) . "\n";
            echo "PHP: " . PHP_VERSION . "\n\n";
            break;

        case 'help':
        default:
            echo "\n\033[1;36m Trindade CLI \033[0m\n\n";
            echo "  php trindade routes              List all routes\n";
            echo "  php trindade cache:clear         Clear storage\n";
            echo "  php trindade key:generate        Generate APP_KEY\n";
            echo "  php trindade serve [--port=8000] Dev server\n";
            echo "  php trindade studio             Studio info\n";
            echo "  php trindade studio:install     Install Studio plugin\n";
            echo "  php trindade make:password       Hash a password\n";
            echo "  php trindade make:jwt [payload]  Generate JWT\n";
            echo "  php trindade env:check           Check extensions\n";
            echo "  php trindade help                This help\n\n";
            break;
    }
} catch (\Throwable $e) {
    echo "\033[31m Error: \033[0m{$e->getMessage()}\n";
    exit(1);
}
